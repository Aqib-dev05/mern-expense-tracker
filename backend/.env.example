# Server
PORT=5000
NODE_ENV=development

# MongoDB (local) or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/expense-tracker

# Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Forgot-password emails are sent through Gmail (nodemailer).
# GMAIL_APP_PASSWORD is a Google "App password" (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT your normal Gmail password. If both are empty in development, the reset code is printed in the server console.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=
