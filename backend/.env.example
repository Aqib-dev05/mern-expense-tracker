# Server
PORT=5000
NODE_ENV=development

# MongoDB (local) or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/expense-tracker

# Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Forgot-password emails (SMTP). For Gmail: enable 2-Step Verification, then create an "App password".
# If SMTP_USER/SMTP_PASS are empty in development, the reset code is printed in the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ledgerly <your-address@gmail.com>"
